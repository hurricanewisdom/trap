# Trap configuration. Copy to .env and fill in the required values.
#
# pm2 loads this with `node --env-file=.env`, which puts the values in
# process.env without touching the process environment. Checking
# /proc/<pid>/environ to confirm one is set gives a false negative.

# Required -------------------------------------------------------------------

# A missing or malformed token exits 78 and pm2 stops the app rather than
# restart-looping.
DISCORD_TOKEN=

DATABASE_URL=postgres://user:password@127.0.0.1:5432/trap

# Discord --------------------------------------------------------------------

# The default prefix. A server can set its own with ,prefix; mentioning the bot
# always works whatever this says.
PREFIX=,

# Comma-separated guild ids to register /help in.
GUILD_IDS=

# "guild" registers slash commands only in GUILD_IDS, which is instant.
# Anything else registers globally.
COMMAND_SCOPE=global

# 1 requests the privileged GuildMembers intent, which joins, leaves and boosts
# need. Only set this if the intent is enabled in the Developer Portal:
# requesting one that is not closes the gateway with 4014 and the bot never
# starts.
GUILD_MEMBERS_INTENT=1

# Redis ----------------------------------------------------------------------

# The server runs maxmemory-policy noeviction and is shared with another
# application, so every key the bot writes carries a TTL.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

PG_POOL_MAX=8

# Last.fm --------------------------------------------------------------------

# From https://www.last.fm/api/account/create, with the callback set to
# <LASTFM_CALLBACK_BASE>/lastfm/callback. Without these the commands say
# linking is unavailable instead of failing.
LASTFM_API_KEY=
LASTFM_API_SECRET=
LASTFM_CALLBACK_BASE=https://trap.rocks

# Callback listener ----------------------------------------------------------

# Loopback plus the docker bridge, so the nginx container can reach it. Never
# 0.0.0.0: this host accepts all inbound TCP and a wildcard bind would publish
# the listener to the internet.
HTTP_BIND=127.0.0.1,172.17.0.1
HTTP_PORT=8730

# Other services -------------------------------------------------------------

# Weather, Valorant, Steam and Roblox account links. Each command says the key
# is missing rather than failing as though the service were down.
OPENWEATHER_API_KEY=
HENRIK_API_KEY=
STEAM_API_KEY=
BLOXLINK_API_KEY=

# Where the programs live ----------------------------------------------------

# Overrides for the things the bot shells out to. The defaults are right on the
# box this runs on; they exist so a different machine does not need a rebuild.
YTDLP_PATH=/usr/local/bin/yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# A Netscape cookie file, which is what a private instagram post needs. Belongs
# to the reposter, which is switched off at the moment.
YTDLP_COOKIES=

# Headless Chrome for `screenshot`, and the unprivileged account it runs as.
# Never the bot's own user: this points a browser at a stranger's url.
CHROME_PATH=google-chrome
CHROME_USER=trapshot

# The self-hosted Piston that `run` executes code in. Loopback only -- this
# runs code a stranger typed and must not be reachable from outside the box.
PISTON_URL=http://127.0.0.1:2000/api/v2

# The local model behind `ask`. Loopback only for the same reason, plus that an
# open unauthenticated model is somebody else's free compute.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# The virtualenv holding faster-whisper and shazamio, and the script that uses
# them. Not the system python: neither will install into Debian's without
# fighting its packages.
TRAP_PYTHON=/opt/trap-py/bin/python
TRAP_AUDIO=/root/trap/tools/audio.py

# Debug ----------------------------------------------------------------------

# 1 logs raw gateway dispatch names.
TRAP_TRACE=
