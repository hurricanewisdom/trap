# Trap configuration. Copy to .env and fill in the required values.
#
# pm2 loads this with `node --env-file=.env`, which puts the values in
# process.env without touching the process environment. Checking
# /proc/<pid>/environ to confirm one is set gives a false negative.

# Required -------------------------------------------------------------------

# A missing or malformed token exits 78 and pm2 stops the app rather than
# restart-looping.
DISCORD_TOKEN=

DATABASE_URL=postgres://user:password@127.0.0.1:5432/trap

# Discord --------------------------------------------------------------------

# The default prefix. A server can set its own with ,prefix; mentioning the bot
# always works whatever this says.
PREFIX=,

# Comma-separated guild ids to register /help in.
GUILD_IDS=

# "guild" registers slash commands only in GUILD_IDS, which is instant.
# Anything else registers globally.
COMMAND_SCOPE=global

# 1 requests the privileged GuildMembers intent, which joins, leaves and boosts
# need. Only set this if the intent is enabled in the Developer Portal:
# requesting one that is not closes the gateway with 4014 and the bot never
# starts.
GUILD_MEMBERS_INTENT=1

# Redis ----------------------------------------------------------------------

# The server runs maxmemory-policy noeviction and is shared with another
# application, so every key the bot writes carries a TTL.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

PG_POOL_MAX=8

# Last.fm --------------------------------------------------------------------

# From https://www.last.fm/api/account/create, with the callback set to
# <LASTFM_CALLBACK_BASE>/lastfm/callback. Without these the commands say
# linking is unavailable instead of failing.
LASTFM_API_KEY=
LASTFM_API_SECRET=
LASTFM_CALLBACK_BASE=https://trap.rocks

# Callback listener ----------------------------------------------------------

# Loopback plus the docker bridge, so the nginx container can reach it. Never
# 0.0.0.0: this host accepts all inbound TCP and a wildcard bind would publish
# the listener to the internet.
HTTP_BIND=127.0.0.1,172.17.0.1
HTTP_PORT=8730

# Debug ----------------------------------------------------------------------

# 1 logs raw gateway dispatch names.
TRAP_TRACE=
