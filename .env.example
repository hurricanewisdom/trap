# Configuration for Trap. Copy to .env and fill in.
# Real values are never committed; see .gitignore.

DISCORD_TOKEN=    # from the Discord developer portal
GUILD_IDS=    # comma separated; used when COMMAND_SCOPE=guild
TRAP_TRACE=
DATABASE_URL=    # postgres://user:password@host:5432/trap
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=    # shared box: db0 belongs to another app
PREFIX=    # kept only so help can name it; nothing dispatches on it
HTTP_PORT=
LASTFM_CALLBACK_BASE=    # public base of the OAuth callback
LASTFM_API_KEY=    # https://www.last.fm/api/account/create
LASTFM_API_SECRET=
HTTP_BIND=    # loopback + docker bridge, never 0.0.0.0
COMMAND_SCOPE=    # guild for instant registration, otherwise global
